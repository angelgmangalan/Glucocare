# Phase 4 local medical-knowledge retrieval configuration
GLUCOCARE_KNOWLEDGE_BASE=knowledge_base
GLUCOCARE_VECTOR_DB=vector_db
GLUCOCARE_EMBEDDING_PROVIDER=hashing
GLUCOCARE_EMBEDDING_MODEL=local-feature-hashing-v1
GLUCOCARE_CHUNK_SIZE=800
GLUCOCARE_CHUNK_OVERLAP=100
GLUCOCARE_TOP_K=5
GLUCOCARE_MIN_RELEVANCE_SCORE=0.08

# Phase 5 OpenAI-compatible Chat Completions API
# Copy this file to .env and set the key locally; never commit the populated .env.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700
LLM_TIMEOUT_SECONDS=30
MAX_HISTORY_MESSAGES=10
RAG_TOP_K=5

# Phase 7 food-photo analysis (OpenAI-compatible vision-capable chat model)
# Set VISION_API_KEY or reuse LLM_API_KEY. Never put a real key in this example file.
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini
VISION_BASE_URL=https://api.openai.com/v1
VISION_TIMEOUT_SECONDS=45
FOOD_IMAGE_MAX_UPLOAD_MB=10
